:8080 {
    encode gzip

    # handle blocks are mutually exclusive: never rewrite /api/* or /up to SPA.
    handle /api/* {
        reverse_proxy api-preview:8000
    }
    @dashboard path /dashboard /dashboard/*
    handle @dashboard {
        forward_auth api-preview:8000 {
            uri /api/streamlit/verificar
            header_up Accept application/json
        }
        reverse_proxy streamlit-preview:8501
    }
    handle /up {
        reverse_proxy api-preview:8000
    }
    # Pacotes para descarregar (extensão CIS WhatsApp): nunca cair na página do CIS,
    # senão o navegador grava o index.html com o nome .zip («pasta comprimida inválida»).
    @zip path *.zip
    handle @zip {
        root * /srv/cis
        header Content-Disposition "attachment"
        file_server
    }
    handle {
        root * /srv/cis
        try_files {path} /index.html
        file_server
    }
    header @dashboard X-Frame-Options SAMEORIGIN
    @outsideDashboard not path /dashboard /dashboard/*
    header @outsideDashboard X-Frame-Options DENY
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control "no-store"
    }
}
