:8080 {
    encode gzip
    @api path /api/*
    reverse_proxy @api api-preview:8000
    reverse_proxy /up api-preview:8000
    root * /srv/cis
    try_files {path} /index.html
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control "no-store"
    }
}
