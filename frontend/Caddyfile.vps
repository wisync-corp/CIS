{
    email {$ACME_EMAIL}
}
{$CIS_DOMAIN} {
    encode zstd gzip

    # API requests must bypass SPA fallback and retain the /api prefix.
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /up {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/cis
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
