{
    email {$ACME_EMAIL}
}
{$CIS_DOMAIN} {
    encode zstd gzip
    @api path /api/*
    reverse_proxy @api api:8000
    reverse_proxy /up api:8000
    root * /srv/cis
    try_files {path} /index.html
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
