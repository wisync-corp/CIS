APP_NAME=CIS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
DB_CONNECTION=sqlite
CACHE_STORE=file
SESSION_DRIVER=file
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=cis_test_read_only
LEGACY_DB_USERNAME=cis_reader
LEGACY_DB_PASSWORD=
# Caminho para certificado CA oficial do MySQL cloud, dentro do contentor.
LEGACY_DB_SSL_CA=

# Desactivado por defeito; aprovar apenas uma réplica privada e isolada de testes.
CIS_FINANCIAL_TEST_APPROVED=false

# Integração de login legado desactivada até verificar TLS e hashes.
# Só utilizadores CIS preexistentes com legacy_username definido.
CIS_LEGACY_LOGIN_ENABLED=false
LEGACY_AUTH_TABLE=Usuarios
LEGACY_AUTH_USERNAME_COLUMN=
LEGACY_AUTH_PASSWORD_HASH_COLUMN=
