{
  "manifest_version": 3,
  "name": "CIS WhatsApp",
  "version": "1.1.0",
  "description": "Envia pelo WhatsApp Web as mensagens preparadas no CIS (CAPTA). O operador inicia sessão no seu próprio WhatsApp Web.",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "CIS WhatsApp", "default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {"matches": ["https://web.whatsapp.com/*"], "js": ["wa.js"], "run_at": "document_idle"}
  ]
}
